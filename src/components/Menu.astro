---
import LinesIcon from "../components/icons/LinesIcon.astro";

const links = [
  { label: 'Inicio',       id: 'inicio'      },
  { label: 'Trabajos',     id: 'trabajos'    },
  { label: 'Habilidades',  id: 'habilidades' },
  { label: 'Contacto',     id: 'contacto'    },
  { label: 'Sobre\u00A0Mí', id: 'sobremi'     }
];
---

<nav
  id="site-menu"
  class="
    flex items-center gap-2
    p-2 rounded-full border-[3px] border-[var(--card-border)]
    bg-transparent transition-all duration-300 text-glow z-40 relative
  "
>
  <ul class="hidden lg:flex items-center gap-2">
    {links.map(({ label, id }, i) => (
      <li>
        <a
          href={`#${id}`}
          class="
            px-4 py-2 rounded-xl border-[var(--card-border)]
            font-semibold transition-colors duration-300
            hover:bg-[var(--nav-hover-bg-light)] whitespace-nowrap cursor-pointer
          "
        >
          {label}
        </a>
      </li>
    ))}
  </ul>

  <button
    id="menu-toggle"
    class="lg:hidden w-12 h-12 rounded-full border-[3px] border-[var(--card-border)] flex items-center justify-center p-2 bg-transparent cursor-pointer transition-all duration-300"
    aria-label="Abrir menú"
    aria-controls="mobile-menu"
    aria-expanded="false"
    type="button"
  >
    <LinesIcon class="w-6 h-6 fill-current text-[var(--card-border)]" />
  </button>

  <div
    id="mobile-menu"
    class="lg:hidden absolute right-0 top-full mt-2 w-56 flex flex-col items-stretch gap-2 py-2 rounded-md border border-[var(--card-border)] bg-transparent transition-all duration-200 z-50"
    hidden
    aria-hidden="true"
  >
    <ul class="flex flex-col gap-1">
      {links.map(({ label, id }, i) => (
        <li>
          <a
            href={`#${id}`}
            class="block text-center px-4 py-2 rounded-md font-semibold transition-colors duration-200 hover:bg-[var(--nav-hover-bg-light)] cursor-pointer"
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

  <script>
  function getRequiredElement(id) {
    const element = document.getElementById(id);
    if (!element) throw new Error(`Menu element not found: ${id}`);
    return element;
  }

  const menu = getRequiredElement('site-menu');
  const toggle = getRequiredElement('menu-toggle');
  const mobileMenu = getRequiredElement('mobile-menu');

  const glassClasses = [
    'bg-white/10',
    'dark:bg-black/10',
    'backdrop-blur-sm',
    'shadow-md'
  ];

  function handleScrollGlass() {
    if (window.scrollY > 0) {
      menu.classList.add(...glassClasses);
      toggle.classList.add(...glassClasses);
    } else {
      menu.classList.remove(...glassClasses);
      if (mobileMenu.hidden) {
        toggle.classList.remove(...glassClasses);
      }
    }
  }
  window.addEventListener('scroll', handleScrollGlass);
  handleScrollGlass();


  function openMobile() {
    mobileMenu.hidden = false;
    mobileMenu.classList.add(...glassClasses);
    toggle.setAttribute('aria-expanded', 'true');
    toggle.setAttribute('aria-label', 'Cerrar menú');
    mobileMenu.setAttribute('aria-hidden', 'false');
    mobileMenu.querySelector('a')?.focus();
  }
  function closeMobile(restoreFocus = false) {
    mobileMenu.hidden = true;
    mobileMenu.classList.remove(...glassClasses);
    toggle.setAttribute('aria-expanded', 'false');
    toggle.setAttribute('aria-label', 'Abrir menú');
    mobileMenu.setAttribute('aria-hidden', 'true');
    if (window.scrollY === 0) toggle.classList.remove(...glassClasses);
    if (restoreFocus) toggle.focus();
  }

  toggle.addEventListener('click', (e) => {
    e.stopPropagation();
    if (mobileMenu.hidden) openMobile();
    else closeMobile(true);
  });
  mobileMenu.addEventListener('click', (e) => {
    if (e.target instanceof Element && e.target.closest('a')) closeMobile();
  });
  document.addEventListener('click', (e) => {
    if (!(e.target instanceof Node) || !menu.contains(e.target)) closeMobile();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
      closeMobile(true);
    }
  });

  window.addEventListener('resize', () => {
    closeMobile();
  });
</script>
