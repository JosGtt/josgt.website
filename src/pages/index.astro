---
import Menu        from '../components/Menu.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import LangToggle  from '../components/LangToggle.astro';
import Inicio      from '../components/Inicio.astro';
import Trabajos    from '../components/Trabajos.astro';
import Habilidades from '../components/Habilidades.astro';
import Proyectos   from '../components/Proyectos.astro';
import Contacto    from '../components/Contacto.astro';
import SobreMi     from '../components/SobreMi.astro';
import '../styles/global.css';
---

<html class="transition-colors bg-white text-black dark:bg-black dark:text-white">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/assets/logo.png" />
    <title>portfolio</title>

    <style is:global>
      body {
        cursor: auto !important;
      }

      #custom-halo {
        position: fixed;
        left: 0;
        top: 0;
        width: var(--halo-size, 100px);
        height: var(--halo-size, 100px);
        pointer-events: none;
        border-radius: 50%;
        background: radial-gradient(circle at center, rgba(120, 0, 255, 0.28) 0%, transparent 70%);
        transform: translate(-50%, -50%);
        mix-blend-mode: screen;
        opacity: 0;
        visibility: hidden;
        transition: opacity 180ms ease, width 200ms ease, height 200ms ease;
        z-index: 9999;
      }

      #custom-halo.is-visible {
        opacity: 1;
        visibility: visible;
      }

      @media (hover: none), (pointer: coarse) {
        #custom-halo { display: none; }
      }
    </style>
  </head>

  <body class="min-h-screen p-4">
    <div id="custom-halo"></div>

    <script>
      const halo = document.getElementById('custom-halo');
      const mousePointer = window.matchMedia('(hover: hover) and (pointer: fine)');

      if (halo && mousePointer.matches) {
        const hideHalo = () => halo.classList.remove('is-visible');

        document.addEventListener('pointermove', (event) => {
          if (event.pointerType !== 'mouse') return;

          halo.style.left = `${event.clientX}px`;
          halo.style.top = `${event.clientY}px`;
          halo.style.setProperty('--halo-size', event.target instanceof Element && event.target.closest('a, button') ? '180px' : '100px');
          halo.classList.add('is-visible');
        });

        document.addEventListener('pointerout', (event) => {
          if (!event.relatedTarget) hideHalo();
        });
        window.addEventListener('blur', hideHalo);
      }
    </script>

    <header id="site-header" class="sticky top-0 z-50 flex justify-between items-center bg-transparent px-4 py-2">
      <Menu />
      <div class="flex space-x-2">
        <ThemeToggle client:load />
      </div>
    </header>

    <main class="mt-[70px] space-y-16">
      <Inicio />
      <Trabajos />
      <Habilidades />

      <Contacto />
      <SobreMi />
    </main>
    
  </body>
</html>
